{
  "modules": [
    "./register.ts"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(WebSearch|WebFetch|mcp__claude-in-chrome__(navigate|get_page_text)|mcp__Claude_Browser__(navigate|get_page_text)|mcp__.*playwright.*__browser_navigate)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/clean-orchestrator-research.sh"
          }
        ]
      },
      {
        "matcher": "^(Bash|PowerShell|Agent|Task|Edit|Write|NotebookEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "exo hook claude PreToolUse || exit 0",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^SubagentHandback$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/red-gate.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|PowerShell|Edit|Write|NotebookEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "exo hook claude PostToolUse || exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^(Bash|PowerShell|Edit|Write|NotebookEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "exo hook claude PostToolUseFailure || exit 0",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exo hook claude SessionStart --min 0.15.0",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/estilo-directo.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/sdd-wake-guard.sh"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/document-remind.sh"
          },
          {
            "type": "command",
            "command": "exo hook claude Stop || exit 0",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/delegar-decision.sh"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/subagent-inject.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/subagent-bg-guard.sh"
          }
        ]
      }
    ]
  }
}
