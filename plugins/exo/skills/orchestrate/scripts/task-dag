#!/usr/bin/env bash
# Calcula las olas de ejecución de un plan (formato skills/plan/plan-template.md).
#
# Usage: task-dag PLAN_FILE
# Stdout: {"olas": [[ids], ...], "avisos": [...]}
#
# Regla: dos tareas comparten ola solo si sus Files son disjuntos y ninguna
# depende (transitivamente) de la otra vía `Consumes: ... @Task M`. Cada tarea
# va a la ola siguiente a la más alta entre sus dependencias y las tareas
# anteriores con las que comparte algún fichero (orden de aparición).
# Sin datos fiables (una tarea sin **Files:**, @Task inexistente, Consumes sin
# @Task) degrada a una tarea por ola con aviso "DAG: secuencial (<motivo>)".
# Consumo hacia delante sin ciclo: orden topológico estable (desempata por
# numeración) y aviso "DAG: reordenado (Task i consume Task j posterior)".
# Ciclo o autoconsumo: {"olas": [], "avisos": ["DAG: error (<ciclo>)"]}, exit 0;
# el orquestador lo convierte en pregunta del pre-flight.
# Paths: se quita el sufijo :N / :N-M; uno que acaba en / solapa con todo lo
# que empiece por él. Exit 2 solo por error de uso.
set -euo pipefail

if [ $# -ne 1 ]; then
  echo "usage: task-dag PLAN_FILE" >&2
  exit 2
fi
plan=$1
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

awk '
  /^```/ { infence = !infence; next }
  infence { next }
  /^#+[ \t]+Task[ \t]+[0-9]+/ {
    s = $0
    sub(/^#+[ \t]+Task[ \t]+/, "", s)
    match(s, /^[0-9]+/)
    id = substr(s, 1, RLENGTH) + 0
    if (id in idx) dupid = id
    n++; ids[n] = id; idx[id] = n; hasfiles[n] = 0; nf[n] = 0
    cur = n; sec = ""
    next
  }
  !cur { next }
  /^\*\*[^*]+:\*\*/ {
    sec = $0
    sub(/^\*\*/, "", sec); sub(/:\*\*.*/, "", sec)
    if (sec == "Files") hasfiles[cur] = 1
    next
  }
  sec == "Files" && /^[ \t]*[-*]/ {
    l = $0; got = 0
    while (match(l, /`[^`]+`/)) {
      p = substr(l, RSTART + 1, RLENGTH - 2)
      l = substr(l, RSTART + RLENGTH)
      while (p ~ /^\.\//) p = substr(p, 3)
      sub(/:[0-9]+(-[0-9]+)?$/, "", p)
      if (p != "") { nf[cur]++; files[cur, nf[cur]] = p; got = 1 }
    }
    if (!got) badfiles[cur] = 1
    next
  }
  sec == "Interfaces" && /^[ \t]*[-*][ \t]+(\*\*)?Consumes:/ {
    l = $0; got = 0
    while (match(l, /@Task[ \t]+[0-9]+/)) {
      m = substr(l, RSTART, RLENGTH); sub(/@Task[ \t]+/, "", m)
      nd[cur]++; dep[cur, nd[cur]] = m + 0; got = 1
      l = substr(l, RSTART + RLENGTH)
    }
    if (!got) badcons[cur] = 1
  }
  function solapa(x, y) {
    if (x == y) return 1
    if (x ~ /\/$/ && index(y, x) == 1) return 1
    if (y ~ /\/$/ && index(x, y) == 1) return 1
    return 0
  }
  function ciclo(   v, path, seen, k, s2, found) {
    for (v = 1; v <= n; v++) if (!done[v]) break
    while (!(v in seen)) {
      seen[v] = ++k; pv[k] = v
      for (d = 1; d <= nd[v]; d++) if (!done[idx[dep[v, d]]]) { v = idx[dep[v, d]]; break }
    }
    s2 = ""
    for (k = seen[v]; k in pv; k++) s2 = s2 "Task " ids[pv[k]] " -> "
    return "ciclo: " s2 "Task " ids[v]
  }
  END {
    seq = 0; motivo = ""; avisos = ""
    if (n == 0) { seq = 1; motivo = "sin tareas reconocibles" }
    if (dupid != "") { seq = 1; motivo = "Task " dupid " duplicada" }
    for (i = 1; i <= n && !seq; i++) {
      if (!hasfiles[i]) { seq = 1; motivo = "Task " ids[i] " sin **Files:**" }
      else if (nf[i] == 0 || badfiles[i]) { seq = 1; motivo = "Task " ids[i] ": Files sin paths legibles" }
      else if (badcons[i]) { seq = 1; motivo = "Task " ids[i] ": Consumes sin @Task M" }
      for (d = 1; d <= nd[i] && !seq; d++) {
        m = dep[i, d]
        if (!(m in idx)) { seq = 1; motivo = "Task " ids[i] " consume @Task " m " inexistente" }
      }
    }
    err = ""
    if (!seq) {
      for (i = 1; i <= n && err == ""; i++)
        for (d = 1; d <= nd[i]; d++)
          if (idx[dep[i, d]] == i) { err = "autoconsumo: Task " ids[i]; break }
      # orden topológico estable (desempata por numeración de aparición)
      for (p = 1; p <= n && err == ""; p++) {
        pick = 0
        for (i = 1; i <= n && !pick; i++) {
          if (done[i]) continue
          ok = 1
          for (d = 1; d <= nd[i]; d++) if (!done[idx[dep[i, d]]]) { ok = 0; break }
          if (ok) pick = i
        }
        if (!pick) { err = ciclo(); break }
        done[pick] = 1; order[p] = pick
      }
    }
    if (err != "") {
      print "{\"olas\": [], \"avisos\": [\"DAG: error (" err ")\"]}"
      exit 0
    }
    if (seq) {
      for (i = 1; i <= n; i++) wave[i] = i
      maxw = n
    } else {
      maxw = 0
      for (p = 1; p <= n; p++) {
        i = order[p]; w = 1
        for (d = 1; d <= nd[i]; d++) {
          j = idx[dep[i, d]]
          if (j > i) avisos = avisos (avisos == "" ? "" : ", ") "\"DAG: reordenado (Task " ids[i] " consume Task " ids[j] " posterior)\""
          x = wave[j] + 1; if (x > w) w = x
        }
        for (q = 1; q < p; q++) {
          j = order[q]; share = 0
          for (a = 1; a <= nf[i] && !share; a++)
            for (b = 1; b <= nf[j] && !share; b++)
              if (solapa(files[i, a], files[j, b])) share = 1
          if (share && wave[j] + 1 > w) w = wave[j] + 1
        }
        wave[i] = w
        if (w > maxw) maxw = w
      }
    }
    out = "{\"olas\": ["
    for (w = 1; w <= maxw; w++) {
      out = out (w > 1 ? ", " : "") "["
      first = 1
      for (i = 1; i <= n; i++) if (wave[i] == w) { out = out (first ? "" : ", ") ids[i]; first = 0 }
      out = out "]"
    }
    out = out "], \"avisos\": ["
    if (seq) out = out "\"DAG: secuencial (" motivo ")\""
    else out = out avisos
    print out "]}"
  }
' "$plan"
