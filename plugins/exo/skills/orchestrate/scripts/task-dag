#!/usr/bin/env bash
# Calcula las olas de ejecución de un plan (formato skills/plan/plan-template.md).
#
# Usage: task-dag PLAN_FILE
# Stdout: {"olas": [[ids], ...], "avisos": [...]}
#
# Regla: dos tareas comparten ola solo si sus Files son disjuntos y ninguna
# depende (transitivamente) de la otra vía `Consumes: ... @Task M`. Cada tarea
# va a la ola siguiente a la más alta entre sus dependencias y las tareas
# anteriores con las que comparte algún fichero (orden de aparición).
# Sin datos fiables (una tarea sin **Files:**, @Task inexistente) degrada a
# una tarea por ola con aviso "DAG: secuencial (<motivo>)"; nunca bloquea.
# Exit 2 solo por error de uso.
set -euo pipefail

if [ $# -ne 1 ]; then
  echo "usage: task-dag PLAN_FILE" >&2
  exit 2
fi
plan=$1
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

awk '
  /^```/ { infence = !infence; next }
  infence { next }
  /^#+[ \t]+Task[ \t]+[0-9]+/ {
    s = $0
    sub(/^#+[ \t]+Task[ \t]+/, "", s)
    match(s, /^[0-9]+/)
    id = substr(s, 1, RLENGTH) + 0
    if (id in idx) dupid = id
    n++; ids[n] = id; idx[id] = n; hasfiles[n] = 0; nf[n] = 0
    cur = n; sec = ""
    next
  }
  !cur { next }
  /^\*\*[^*]+:\*\*/ {
    sec = $0
    sub(/^\*\*/, "", sec); sub(/:\*\*.*/, "", sec)
    if (sec == "Files") hasfiles[cur] = 1
    next
  }
  sec == "Files" && /^[ \t]*[-*]/ {
    l = $0; got = 0
    while (match(l, /`[^`]+`/)) {
      p = substr(l, RSTART + 1, RLENGTH - 2)
      l = substr(l, RSTART + RLENGTH)
      while (p ~ /^\.\//) p = substr(p, 3)
      if (p != "") { nf[cur]++; files[cur, nf[cur]] = p; got = 1 }
    }
    if (!got) badfiles[cur] = 1
    next
  }
  sec == "Interfaces" && /^[ \t]*[-*][ \t]+Consumes:/ {
    l = $0
    while (match(l, /@Task[ \t]+[0-9]+/)) {
      m = substr(l, RSTART, RLENGTH); sub(/@Task[ \t]+/, "", m)
      nd[cur]++; dep[cur, nd[cur]] = m + 0
      l = substr(l, RSTART + RLENGTH)
    }
  }
  END {
    seq = 0; motivo = ""
    if (n == 0) { seq = 1; motivo = "sin tareas reconocibles" }
    if (dupid != "") { seq = 1; motivo = "Task " dupid " duplicada" }
    for (i = 1; i <= n && !seq; i++) {
      if (!hasfiles[i]) { seq = 1; motivo = "Task " ids[i] " sin **Files:**" }
      else if (nf[i] == 0 || badfiles[i]) { seq = 1; motivo = "Task " ids[i] ": Files sin paths legibles" }
      for (d = 1; d <= nd[i] && !seq; d++) {
        m = dep[i, d]
        if (!(m in idx)) { seq = 1; motivo = "Task " ids[i] " consume @Task " m " inexistente" }
        else if (idx[m] >= i) { seq = 1; motivo = "Task " ids[i] " consume @Task " m " que no la precede" }
      }
    }
    if (seq) {
      for (i = 1; i <= n; i++) wave[i] = i
      maxw = n
    } else {
      maxw = 0
      for (i = 1; i <= n; i++) {
        w = 1
        for (d = 1; d <= nd[i]; d++) { x = wave[idx[dep[i, d]]] + 1; if (x > w) w = x }
        for (j = 1; j < i; j++) {
          share = 0
          for (a = 1; a <= nf[i] && !share; a++)
            for (b = 1; b <= nf[j] && !share; b++)
              if (files[i, a] == files[j, b]) share = 1
          if (share && wave[j] + 1 > w) w = wave[j] + 1
        }
        wave[i] = w
        if (w > maxw) maxw = w
      }
    }
    out = "{\"olas\": ["
    for (w = 1; w <= maxw; w++) {
      out = out (w > 1 ? ", " : "") "["
      first = 1
      for (i = 1; i <= n; i++) if (wave[i] == w) { out = out (first ? "" : ", ") ids[i]; first = 0 }
      out = out "]"
    }
    out = out "], \"avisos\": ["
    if (seq) out = out "\"DAG: secuencial (" motivo ")\""
    print out "]}"
  }
' "$plan"
