#!/usr/bin/env bash
# Derived from superpowers 7.0.2 (MIT © 2025 Jesse Vincent)
#
# Extract one task's full text from an implementation plan into a file the
# implementer reads in one call, so the task text never has to be pasted
# through the controller's context.
#
# Usage: task-brief PLAN_FILE TASK_NUMBER [OUTFILE]
# Default OUTFILE: <repo-root>/.superpowers/sdd/<plan-basename>/task-<N>-brief.md
# (per plan and per worktree; concurrent runs of the SAME plan in the same
# working tree share it).
# Exit 4: DAG inválido o la ola anterior sin cierre verde (gate de ola).
set -euo pipefail

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: task-brief PLAN_FILE TASK_NUMBER [OUTFILE]" >&2
  exit 2
fi

plan=$1
n=$2
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

here=$(cd "$(dirname "$0")" && pwd)

# Gate de ola: la tarea de la ola K>1 solo sale si el ledger tiene `Ola K-1: cierre — verde`
# (lo escribe `sdd-workspace wave-close`; el último resumen de esa ola manda). Sin --force.
dag=$("$here/task-dag" "$plan")
case "$dag" in
  *'"olas": []'*) echo "DAG inválido, resuélvelo con un Ruling antes de despachar: $dag" >&2; exit 4 ;;
esac
k=$(printf '%s\n' "$dag" | awk -v n="$n" '{
  s = $0; sub(/^\{"olas": \[/, "", s); sub(/\], "avisos".*/, "", s)
  w = split(s, ws, /\], \[/)
  for (i = 1; i <= w; i++) { g = ws[i]; gsub(/[^0-9,]/, "", g); c = split(g, ids, ",")
    for (j = 1; j <= c; j++) if (ids[j] == n) { print i; exit } } }')
dir=$("$here/sdd-workspace" "$plan")
if [ -n "$k" ] && [ "$k" -gt 1 ]; then
  prev=$((k - 1))
  last=$(awk -v k="$prev" 'index($0, "Ola " k ": cierre — ") == 1 && ($0 ~ /cierre — (verde|ROJO) /) { l = $0 } END { print l }' "$dir/progress.md" 2>/dev/null || true)
  case "$last" in
    *"cierre — verde "*) ;;
    *) echo "Task ${n} es de la ola ${k} y la ola ${prev} no tiene cierre verde en el ledger: corre 'sdd-workspace wave-close ${plan} ${prev}'" >&2; exit 4 ;;
  esac
fi

if [ $# -eq 3 ]; then
  out=$3
else
  out="$dir/task-${n}-brief.md"
fi

# Un encabezado de tarea es `Task` + un ID: letras y dígitos, opcionalmente
# separados por puntos, con al menos un dígito (3, 6b, A1, 2.1); el dígito evita
# que "## Task Overview" o "#### Task notes" cuenten como frontera. El ID se
# compara con TASK_NUMBER como cadena entera (Task 6 no casa Task 6b ni Task 1
# casa Task 1.1) y TASK_NUMBER nunca llega a awk como regex. Un encabezado Task
# más profundo cuyo ID extiende el pedido con letra o punto es una subtarea y
# se queda en su brief (### Task 7 conserva #### Task 7a). La profundidad sola
# no basta: los planes derivan de "## Task 1" a "### Task 2".
#
# La palabra sigue siendo el literal inglés "Task" aunque el plan esté en otro
# idioma. Un plan sin ningún encabezado Task suele haberla traducido
# ("## Tarea 1"): lista los encabezados con forma de tarea antes del error.
#
# Una valla sin cerrar esconde todos los encabezados Task posteriores. Si
# esconde uno mientras se captura la tarea pedida, su final no se encuentra y
# el brief correría hasta el EOF por todas las tareas siguientes: se niega
# (exit 4) en vez de entregar varias tareas como requisitos. Si esconde el
# encabezado pedido, lo dice antes del error de no encontrada. Una valla suelta
# que no esconde ningún Task (los planes reales acaban con un ``` solo) deja el
# brief completo: se emite con aviso. La ruta del plan va por ENVIRON, no -v,
# que destrozaría las barras de una ruta Windows.
rc=0
TASK_BRIEF_PLAN="$plan" awk -v n="$n" '
  /^```/ { infence = !infence; if (infence) { fence_line = NR; hidden = 0 } }
  infence && /^#+[ \t]+Task[ \t]/ { hidden = 1 }
  !infence && /^#+[ \t]+Task[ \t]/ {
    id = $0
    sub(/^#+[ \t]+Task[ \t]+/, "", id)
    if (match(id, /^[A-Za-z0-9]+(\.[A-Za-z0-9]+)*/) && substr(id, 1, RLENGTH) ~ /[0-9]/) {
      tasks++
      id = substr(id, 1, RLENGTH)
      match($0, /^#+/)
      subtask = intask && RLENGTH > level && substr(id, 1, length(n)) == n \
        && substr(id, length(n) + 1, 1) ~ /[A-Za-z.]/
      if (!subtask) {
        intask = (id == n)
        level = RLENGTH
      }
    }
  }
  !infence && /^#+[ \t]+[^ \t]+[ \t]+[A-Za-z0-9.]*[0-9]/ && shaped < 5 { shaped_heading[++shaped] = $0 }
  intask { print; found = 1 }
  END {
    where = "the code fence opened at line " fence_line " of " ENVIRON["TASK_BRIEF_PLAN"] " never closes"
    if (infence && hidden && (intask || !found)) {
      print "task-brief: " where ", so no Task heading after it can be seen; close that fence in the plan and rerun" | "cat >&2"
      if (intask) exit 4
    } else if (infence && intask) {
      print "task-brief: warning: " where "; it hides no Task heading, so this brief is complete" | "cat >&2"
    }
    # Una valla abierta que escondió encabezados ya explica por qué no se vio
    # ninguno; la pista de la palabra inglesa la contradiría.
    if (!tasks && shaped && !(infence && hidden)) {
      print "task-brief: no task headings found. Task headings must use the English word \"Task\" (\"### Task 1: ...\"), even when the rest of the plan is in another language. Headings shaped like tasks:" | "cat >&2"
      for (i = 1; i <= shaped; i++) print "  " shaped_heading[i] | "cat >&2"
    }
  }
' "$plan" > "$out" || rc=$?
if [ "$rc" -ne 0 ]; then
  if [ -f "$out" ]; then rm -f "$out"; fi
  exit "$rc"
fi

if [ ! -s "$out" ]; then
  echo "task ${n} not found in ${plan} (no heading matching 'Task ${n}')" >&2
  exit 3
fi

echo "wrote ${out}: $(wc -l < "$out" | tr -d ' ') lines"
