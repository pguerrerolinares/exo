#!/usr/bin/env bash
# Derived from superpowers 7.0.0 (MIT © 2025 Jesse Vincent)
#
# Resolve and ensure the working-tree directory SDD uses for one plan's
# short-lived artifacts: task briefs, implementer reports, review packages,
# and the progress ledger. Print the plan directory's absolute path.
#
# One directory per plan (.superpowers/sdd/<plan-basename>/) so a follow-up
# plan in the same working tree can never read or overwrite another plan's
# artifacts. A stale ledger misread as current progress makes controllers
# skip whole task sequences — plan-scoping removes that failure structurally.
#
# Basename slugs collide when two plans share a filename (docs/alpha/plan.md
# vs docs/beta/plan.md), so each workspace records its owning plan's path in
# a plan-path marker (repo-relative in-repo, absolute outside). A workspace
# owned by a different plan is skipped and the slug disambiguated with the
# plan's parent-directory name, then a counter. A workspace with no marker
# predates the marker scheme and is adopted for the current plan so in-flight
# workspaces keep resolving — which means the first collision on such a
# legacy workspace adopts instead of detecting; acceptable, marker-less
# workspaces age out as plans finish.
#
# The workspace lives in the working tree (not under .git/) because Claude Code
# treats .git/ as a protected path and denies agent writes there — which blocks
# an implementer subagent from writing its report file. A self-ignoring
# .gitignore at .superpowers/sdd/ keeps every plan's workspace out of
# `git status` and out of accidental commits without modifying any tracked file.
#
# Single source of truth for the workspace location, so task-brief and
# review-package cannot drift to different directories.
#
# `close` cierra la orquestación del plan: archiva progress.md/final-review.md fuera
# del repo, limpia los worktrees y ramas de tarea ya integrados en HEAD y borra el
# workspace de ESTE plan (nunca .superpowers/sdd/ entero ni sus hermanos). Sin --force:
# lo sucio o sin integrar se queda y el exit es 1.
#
# Usage: sdd-workspace PLAN_FILE
#        sdd-workspace close PLAN_FILE [--archive DIR] [--prefix PREFIJO]
set -euo pipefail

close=0
if [ "${1:-}" = close ]; then
  close=1; shift
  archive="${EXO_SDD_ARCHIVE:-$HOME/.local/share/exo/sdd-archive}"; archive_set=0
  prefix=task/
  plan=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --archive) [ $# -ge 2 ] || { echo "--archive necesita DIR" >&2; exit 2; }; archive=$2; archive_set=1; shift 2 ;;
      --prefix)  [ $# -ge 2 ] || { echo "--prefix necesita PREFIJO" >&2; exit 2; }; prefix=$2; shift 2 ;;
      *) [ -z "$plan" ] || { echo "usage: sdd-workspace close PLAN_FILE [--archive DIR] [--prefix PREFIJO]" >&2; exit 2; }
         plan=$1; shift ;;
    esac
  done
  [ -n "$plan" ] || { echo "usage: sdd-workspace close PLAN_FILE [--archive DIR] [--prefix PREFIJO]" >&2; exit 2; }
  # Un prefijo vacío o con glob casaría ramas ajenas (main incluida) y close las borraría.
  case "$prefix" in
    ""|*[\*\?\[]*) echo "--prefix inválido (no vacío, sin * ? [): '$prefix'" >&2; exit 2 ;;
  esac
else
  if [ $# -ne 1 ]; then
    echo "usage: sdd-workspace PLAN_FILE" >&2
    exit 2
  fi
  plan=$1
fi
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

slug=$(basename "$plan" .md)
[ -n "$slug" ] && [ "$slug" != "." ] && [ "$slug" != ".." ] \
  || { echo "cannot derive a workspace name from: $plan" >&2; exit 2; }

# Physical path, spelled the way pwd -P spells the plan path below: on Git
# Bash, rev-parse prints C:/repo/... while pwd prints /c/repo/..., and the
# repo-relative marker check needs both in the same form.
root=$(CDPATH='' cd -- "$(git rev-parse --show-toplevel)" && pwd -P)
base="$root/.superpowers/sdd"

# Normalize the plan path (physical directory, so relative/absolute/../
# spellings of one plan compare equal) and express it as the marker value:
# repo-relative when the plan lives under the repo root, absolute otherwise.
plan_dir=$(CDPATH='' cd -- "$(dirname "$plan")" && pwd -P)
plan_abs="$plan_dir/$(basename "$plan")"
case "$plan_abs" in
  "$root"/*) plan_id=${plan_abs#"$root"/} ;;
  *)         plan_id=$plan_abs ;;
esac

# True when the workspace at $1 is (or becomes) this plan's: an existing
# marker must name this plan; a missing marker means a new workspace or a
# pre-marker legacy one, and either way the plan claims it by writing one.
owns() {
  if [ "$close" = 1 ]; then
    [ -d "$1" ] || { echo "sin workspace para el plan: $plan" >&2; exit 2; }
    [ ! -e "$1/plan-path" ] || [ "$(cat "$1/plan-path")" = "$plan_id" ]
  elif [ -e "$1/plan-path" ]; then
    [ "$(cat "$1/plan-path")" = "$plan_id" ]
  else
    mkdir -p "$1"
    printf '%s\n' "$plan_id" > "$1/plan-path"
  fi
}

dir="$base/$slug"
if ! owns "$dir"; then
  parent=$(basename "$plan_dir")
  dir="$base/$slug-$parent"
  if ! owns "$dir"; then
    n=2
    while ! owns "$base/$slug-$parent-$n"; do n=$((n + 1)); done
    dir="$base/$slug-$parent-$n"
  fi
fi

if [ "$close" = 1 ]; then
  slug=$(basename "$dir")
  pending=0

  common=$(CDPATH='' cd -- "$(git rev-parse --git-common-dir)" && pwd -P)
  repo_name=$(basename "$(dirname "$common")")
  [ "$archive_set" = 1 ] || archive="$archive/$repo_name"

  archived_ok=1
  # archivar SRC SUFIJO -> copia sin sobrescribir nunca (-2, -3…) y verifica el byte a byte
  archivar() {
    local dest n=1 stem day
    day=$(date +%F); stem="$archive/$slug-$day-$2"
    dest="$stem.md"
    while [ -e "$dest" ]; do n=$((n + 1)); dest="$stem-$n.md"; done
    if mkdir -p "$archive" && cp "$1" "$dest" && cmp -s "$1" "$dest"; then
      echo "archivado: $(CDPATH='' cd -- "$archive" && pwd -P)/$(basename "$dest")"
    else
      echo "no archivado: $1" >&2; archived_ok=0
    fi
  }
  if [ -f "$dir/progress.md" ]; then
    archivar "$dir/progress.md" progress
  else
    echo "sin ledger que archivar"
  fi
  [ ! -f "$dir/final-review.md" ] || archivar "$dir/final-review.md" final-review

  cur=$(git symbolic-ref -q --short HEAD || true)
  declare -A wt_of=()
  wpath=""
  while IFS= read -r l; do
    case "$l" in
      "worktree "*) wpath=${l#worktree } ;;
      "branch refs/heads/"*) wt_of["${l#branch refs/heads/}"]=$wpath ;;
    esac
  done < <(git worktree list --porcelain)

  while IFS= read -r br; do
    [ -n "$br" ] && [ "$br" != "$cur" ] || continue
    if ! git merge-base --is-ancestor "$br" HEAD; then
      echo "sin integrar (se queda): $br"; pending=1; continue
    fi
    wp=${wt_of[$br]:-}
    if [ -n "$wp" ]; then
      if err=$(git worktree remove "$wp" 2>&1); then
        echo "worktree eliminado: $wp ($br)"
      else
        echo "no eliminado: $wp ($(printf '%s\n' "$err" | head -n 1))"; pending=1; continue
      fi
    fi
    if err=$(git branch -d "$br" 2>&1); then
      echo "rama borrada: $br"
    else
      echo "no eliminado: $br ($(printf '%s\n' "$err" | head -n 1))"; pending=1
    fi
  done < <(git for-each-ref --format='%(refname:short)' "refs/heads/${prefix}*")
  git worktree prune

  if [ "$archived_ok" = 1 ]; then
    rm -rf -- "$dir"
    echo "workspace borrado: $dir"
  else
    echo "workspace conservado (archivado fallido): $dir"; pending=1
  fi
  exit "$pending"
fi

# Create-only: a repo may commit its own .gitignore here (e.g. to version
# progress.md ledgers); overwriting it would revert that on every run.
[ -e "$base/.gitignore" ] || printf '*\n' > "$base/.gitignore"
CDPATH='' cd -- "$dir" && pwd
