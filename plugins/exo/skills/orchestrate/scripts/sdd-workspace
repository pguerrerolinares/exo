#!/usr/bin/env bash
# Derived from superpowers 7.0.0 (MIT © 2025 Jesse Vincent)
#
# Resolve and ensure the working-tree directory SDD uses for one plan's
# short-lived artifacts: task briefs, implementer reports, review packages,
# and the progress ledger. Print the plan directory's absolute path.
#
# One directory per plan (.superpowers/sdd/<plan-basename>/) so a follow-up
# plan in the same working tree can never read or overwrite another plan's
# artifacts. A stale ledger misread as current progress makes controllers
# skip whole task sequences — plan-scoping removes that failure structurally.
#
# Basename slugs collide when two plans share a filename (docs/alpha/plan.md
# vs docs/beta/plan.md), so each workspace records its owning plan's path in
# a plan-path marker (repo-relative in-repo, absolute outside). A workspace
# owned by a different plan is skipped and the slug disambiguated with the
# plan's parent-directory name, then a counter. A workspace with no marker
# predates the marker scheme and is adopted for the current plan so in-flight
# workspaces keep resolving — which means the first collision on such a
# legacy workspace adopts instead of detecting; acceptable, marker-less
# workspaces age out as plans finish.
#
# The workspace lives in the working tree (not under .git/) because Claude Code
# treats .git/ as a protected path and denies agent writes there — which blocks
# an implementer subagent from writing its report file. A self-ignoring
# .gitignore at .superpowers/sdd/ keeps every plan's workspace out of
# `git status` and out of accidental commits without modifying any tracked file.
#
# Single source of truth for the workspace location, so task-brief and
# review-package cannot drift to different directories.
#
# `close` cierra la orquestación del plan: archiva progress.md/final-review.md fuera
# del repo, limpia los worktrees y ramas de tarea ya integrados en HEAD y borra el
# workspace de ESTE plan (nunca .superpowers/sdd/ entero ni sus hermanos). Sin --force:
# lo sucio o sin integrar se queda y el exit es 1.
# Antes de tocar nada exige el CI del PR de la rama actual en verde (`gh pr checks`): un
# CI que falla tras el close ya no tiene ledger donde registrar el fix y su Ruling. Sin PR,
# sin gh, pendiente o rojo => exit 1; `--no-ci MOTIVO` lo salta y lo deja en el ledger.
#
# Antes de eso exige que la última ola del plan (task-dag) tenga su cierre en verde en el
# ledger (`Ola K: cierre — verde`, escrito por wave-close); no hay --force ni --no-ci que lo salte.
#
# `wave-close PLAN K` cierra la ola K por script: ejecuta CADA comando de `## Cierre de ola`
# del ledger (`bash -c` en la raíz del repo, sin pipe: el exit es el del comando), anexa
# `Ola K: cierre — <cmd>: exit=N (<última línea>)` por comando y la línea resumen
# `Ola K: cierre — verde (n/n) @<sha>` o `— ROJO (m/n)`. Exit = nº de comandos rojos; sin
# sección o sin comandos => 1. task-brief niega el brief de la ola K+1 sin ese `verde`.
#
# Antes de archivar, `close` anexa al ledger UNA línea `Métricas: clave=valor …` con lo calculable por
# script (olas y anchos, KB del plan y fracción en código, mutación de los review packages, wallclock).
# Un cálculo que falla da `?` en su campo y no cambia el exit ni el archivado del close.
#
# Usage: sdd-workspace PLAN_FILE
#        sdd-workspace wave-close PLAN_FILE K
#        sdd-workspace close PLAN_FILE [--archive DIR] [--prefix PREFIJO] [--no-ci MOTIVO]
set -euo pipefail

close=0; wc=0
if [ "${1:-}" = wave-close ]; then
  [ $# -eq 3 ] || { echo "usage: sdd-workspace wave-close PLAN_FILE K" >&2; exit 2; }
  wc=1; plan=$2; wave=$3
  case "$wave" in ""|*[!0-9]*|0*) echo "K inválida (entero >= 1): '$wave'" >&2; exit 2 ;; esac
elif [ "${1:-}" = close ]; then
  close=1; shift
  archive="${EXO_SDD_ARCHIVE:-$HOME/.local/share/exo/sdd-archive}"; archive_set=0
  prefix=task/
  no_ci=""
  plan=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --archive) [ $# -ge 2 ] || { echo "--archive necesita DIR" >&2; exit 2; }; archive=$2; archive_set=1; shift 2 ;;
      --prefix)  [ $# -ge 2 ] || { echo "--prefix necesita PREFIJO" >&2; exit 2; }; prefix=$2; shift 2 ;;
      --no-ci)   [ $# -ge 2 ] && [ -n "$2" ] || { echo "--no-ci necesita MOTIVO" >&2; exit 2; }; no_ci=$2; shift 2 ;;
      *) [ -z "$plan" ] || { echo "usage: sdd-workspace close PLAN_FILE [--archive DIR] [--prefix PREFIJO] [--no-ci MOTIVO]" >&2; exit 2; }
         plan=$1; shift ;;
    esac
  done
  [ -n "$plan" ] || { echo "usage: sdd-workspace close PLAN_FILE [--archive DIR] [--prefix PREFIJO] [--no-ci MOTIVO]" >&2; exit 2; }
  # Solo un espacio de nombres (`algo/`): un prefijo suelto (`m`) casaría main y close la borraría.
  case "$prefix" in
    ""|/|*[\*\?\[]*|*[!/]) echo "--prefix inválido (debe acabar en /, no ser solo /, sin * ? [): '$prefix'" >&2; exit 2 ;;
  esac
else
  if [ $# -ne 1 ]; then
    echo "usage: sdd-workspace PLAN_FILE" >&2
    exit 2
  fi
  plan=$1
fi
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

slug=$(basename "$plan" .md)
[ -n "$slug" ] && [ "$slug" != "." ] && [ "$slug" != ".." ] \
  || { echo "cannot derive a workspace name from: $plan" >&2; exit 2; }

# Physical path, spelled the way pwd -P spells the plan path below: on Git
# Bash, rev-parse prints C:/repo/... while pwd prints /c/repo/..., and the
# repo-relative marker check needs both in the same form.
root=$(CDPATH='' cd -- "$(git rev-parse --show-toplevel)" && pwd -P)
base="$root/.superpowers/sdd"

# Normalize the plan path (physical directory, so relative/absolute/../
# spellings of one plan compare equal) and express it as the marker value:
# repo-relative when the plan lives under the repo root, absolute otherwise.
plan_dir=$(CDPATH='' cd -- "$(dirname "$plan")" && pwd -P)
plan_abs="$plan_dir/$(basename "$plan")"
case "$plan_abs" in
  "$root"/*) plan_id=${plan_abs#"$root"/} ;;
  *)         plan_id=$plan_abs ;;
esac

# True when the workspace at $1 is (or becomes) this plan's: an existing
# marker must name this plan; a missing marker means a new workspace or a
# pre-marker legacy one, and either way the plan claims it by writing one.
owns() {
  if [ "$close" = 1 ] || [ "$wc" = 1 ]; then
    [ -d "$1" ] || { echo "sin workspace para el plan: $plan" >&2; exit 2; }
    [ ! -e "$1/plan-path" ] || [ "$(cat "$1/plan-path")" = "$plan_id" ]
  elif [ -e "$1/plan-path" ]; then
    [ "$(cat "$1/plan-path")" = "$plan_id" ]
  else
    mkdir -p "$1"
    printf '%s\n' "$plan_id" > "$1/plan-path"
  fi
}

dir="$base/$slug"
if ! owns "$dir"; then
  parent=$(basename "$plan_dir")
  dir="$base/$slug-$parent"
  if ! owns "$dir"; then
    n=2
    while ! owns "$base/$slug-$parent-$n"; do n=$((n + 1)); done
    dir="$base/$slug-$parent-$n"
  fi
fi

if [ "$wc" = 1 ]; then
  ledger="$dir/progress.md"
  cmds=()
  if [ -f "$ledger" ]; then
    while IFS= read -r c; do cmds+=("$c"); done < <(awk '
      /^## / { insec = ($0 ~ /^## Cierre de ola[ \t]*$/); next }
      insec && /^[ \t]*[-*][ \t]/ && match($0, /`[^`]+`/) { print substr($0, RSTART + 1, RLENGTH - 2) }
    ' "$ledger")
  fi
  [ "${#cmds[@]}" -gt 0 ] || { echo "sin comandos en '## Cierre de ola' del ledger ($ledger)" >&2; exit 1; }
  red=0
  for c in "${cmds[@]}"; do
    rc=0; o=$(cd -- "$root" && bash -c "$c" </dev/null 2>&1) || rc=$?
    last=$(printf '%s\n' "$o" | awk 'NF { l = $0 } END { print substr(l, 1, 120) }')
    [ "$rc" = 0 ] || red=$((red + 1))
    printf 'Ola %s: cierre — %s: exit=%s (%s)\n' "$wave" "$c" "$rc" "$last" | tee -a "$ledger"
  done
  sha=$(git -C "$root" rev-parse --short HEAD 2>/dev/null || echo sin-commit)
  if [ "$red" = 0 ]; then
    printf 'Ola %s: cierre — verde (%s/%s) @%s\n' "$wave" "${#cmds[@]}" "${#cmds[@]}" "$sha" | tee -a "$ledger"
  else
    printf 'Ola %s: cierre — ROJO (%s/%s) @%s\n' "$wave" "$red" "${#cmds[@]}" "$sha" | tee -a "$ledger"
  fi
  exit "$red"
fi

if [ "$close" = 1 ]; then
  slug=$(basename "$dir")
  pending=0

  # Última ola del plan sin cierre verde (el último resumen de esa ola manda): hallazgo con el ledger vivo.
  dag=$("$(dirname "$0")/task-dag" "$plan")
  nwaves=$(printf '%s\n' "$dag" | awk '{ s = $0; sub(/^\{"olas": \[/, "", s); sub(/\], "avisos".*/, "", s); n = (s == "") ? 0 : gsub(/\], \[/, "&", s) + 1; print n }')
  if [ "$nwaves" -gt 0 ]; then
    last=$(awk -v k="$nwaves" 'index($0, "Ola " k ": cierre — ") == 1 && ($0 ~ /cierre — (verde|ROJO) /) { l = $0 } END { print l }' "$dir/progress.md" 2>/dev/null || true)
    case "$last" in
      *"cierre — verde "*) ;;
      *) echo "Ola $nwaves sin cierre verde: corre 'sdd-workspace wave-close $plan $nwaves' antes de cerrar (fix dispatch con el ledger vivo si sale rojo)" >&2
         exit 1 ;;
    esac
  fi

  if [ -n "$no_ci" ]; then
    [ ! -f "$dir/progress.md" ] || printf 'close: --no-ci (%s)\n' "$no_ci" >> "$dir/progress.md"
  else
    ci_br=$(git symbolic-ref -q --short HEAD || true)
    # Vacío (sin checks) también bloquea: un repo sin CI lo declara con --no-ci, no por silencio.
    if [ -n "$ci_br" ] && command -v gh >/dev/null 2>&1 \
       && ci_states=$(gh pr checks "$ci_br" --json state --jq '.[].state' 2>/dev/null) \
       && [ -n "$ci_states" ] && ! printf '%s\n' "$ci_states" | grep -qvxE 'SUCCESS|SKIPPED|NEUTRAL'; then
      :
    else
      echo "CI no verde: fix dispatch con el ledger vivo (sin PR/gh/checks, pendiente o rojo en '${ci_br:-HEAD desacoplado}'; --no-ci MOTIVO solo si no hay CI)" >&2
      exit 1
    fi
  fi

  common=$(CDPATH='' cd -- "$(git rev-parse --git-common-dir)" && pwd -P)
  repo_name=$(basename "$(dirname "$common")")
  [ "$archive_set" = 1 ] || archive="$archive/$repo_name"

  archived_ok=1
  # archivar SRC SUFIJO -> copia sin sobrescribir nunca (-2, -3…) y verifica el byte a byte
  archivar() {
    local dest n=1 stem day
    day=$(date +%F); stem="$archive/$slug-$day-$2"
    dest="$stem.md"
    while [ -e "$dest" ]; do n=$((n + 1)); dest="$stem-$n.md"; done
    if mkdir -p "$archive" && cp "$1" "$dest" && cmp -s "$1" "$dest"; then
      echo "archivado: $(CDPATH='' cd -- "$archive" && pwd -P)/$(basename "$dest")"
    else
      echo "no archivado: $1" >&2; archived_ok=0
    fi
  }
  # Métricas de la serie: una línea al ledger. Cada campo es independiente y degrada a `?`:
  # medir nunca cambia el exit ni el archivado.
  metricas() {
    local anchos kb cod mut f bad=0 todas="" una
    anchos=$(printf '%s\n' "$dag" | awk '{ s = $0; sub(/^\{"olas": \[/, "", s); sub(/\], "avisos".*/, "", s)
      if (s == "") { print "-"; exit }
      gsub(/\], \[/, "|", s); gsub(/[\[\]" ]/, "", s); n = split(s, o, "|")
      for (i = 1; i <= n; i++) printf "%s%d", (i > 1 ? "," : ""), gsub(/,/, ",", o[i]) + 1; print "" }') || anchos='?'
    kb=$(LC_ALL=C awk '{ b += length($0) + 1 } END { printf "%.1f", b / 1024 }' "$plan") || kb='?'
    cod=$(LC_ALL=C awk '{ n = length($0) + 1; t += n; if ($0 ~ /^[ \t]*(```|~~~)/) { dentro = !dentro; c += n } else if (dentro) c += n }
      END { printf "%.2f", t ? c / t : 0 }' "$plan") || cod='?'
    for f in "$dir"/review-*.diff; do
      [ -e "$f" ] || continue
      if [ -f "$f" ] && [ -r "$f" ] && una=$(LC_ALL=C awk '
          /^## MUTACI/ { sec = 1; next }
          /^## / { sec = 0 }
          sec && index($0, "MUTACIÓN [") == 1 { l = substr($0, 12); l = substr(l, 1, index(l, "]") - 1); k = 1 }
          sec && index($0, "MUTACIÓN: ") == 1 { l = "global"; k = 2 }
          !k { next }
          { if ($0 !~ /IC95 \[/ && match($0, /\([0-9]+%\)/)) { v = substr($0, RSTART + 1, RLENGTH - 3); if (k == 1) d[l] = v; else g = v }
            k = 0 }
          END { for (x in d) { print x, d[x]; nd++ } if (!nd && g != "") print "global", g }' "$f"); then
        todas="$todas$una"$'\n'
      else
        bad=1
      fi
    done
    if [ "$bad" = 1 ]; then mut='?'
    else
      mut=$(printf '%s' "$todas" | awk 'NF == 2 { if (!($1 in m) || $2 + 0 < m[$1]) m[$1] = $2 + 0 }
        END { for (x in m) printf "%s%s:%d%%", (n++ ? "," : ""), x, m[x] }') || mut='?'
      [ -n "$mut" ] || mut=sin-dato
    fi
    printf 'Métricas: olas=%s anchos=%s plan_kb=%s codigo=%s mutacion=%s wallclock=manual basura=manual turnos=manual\n' \
      "$nwaves" "$anchos" "$kb" "$cod" "$mut"
  }
  if [ -f "$dir/progress.md" ]; then
    { metricas >> "$dir/progress.md"; } 2>/dev/null || true
  fi

  if [ -f "$dir/progress.md" ]; then
    archivar "$dir/progress.md" progress
  else
    echo "sin ledger que archivar"
  fi
  [ ! -f "$dir/final-review.md" ] || archivar "$dir/final-review.md" final-review

  cur=$(git symbolic-ref -q --short HEAD || true)
  default_br=$(git symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null || true)
  default_br=${default_br#origin/}
  declare -A wt_of=()
  wpath=""
  while IFS= read -r l; do
    case "$l" in
      "worktree "*) wpath=${l#worktree } ;;
      "branch refs/heads/"*) wt_of["${l#branch refs/heads/}"]=$wpath ;;
    esac
  done < <(git worktree list --porcelain)

  while IFS= read -r br; do
    [ -n "$br" ] && [ "$br" != "$cur" ] || continue
    # Cinturón: aunque el prefijo case `main/`-algo raro, la rama por defecto nunca se toca.
    case "$br" in main|master|"$default_br") continue ;; esac
    if ! git merge-base --is-ancestor "$br" HEAD; then
      echo "sin integrar (se queda): $br"; pending=1; continue
    fi
    wp=${wt_of[$br]:-}
    if [ -n "$wp" ]; then
      if err=$(git worktree remove "$wp" 2>&1); then
        echo "worktree eliminado: $wp ($br)"
      else
        echo "no eliminado: $wp ($(printf '%s\n' "$err" | head -n 1))"; pending=1; continue
      fi
    fi
    if err=$(git branch -d "$br" 2>&1); then
      echo "rama borrada: $br"
    else
      echo "no eliminado: $br ($(printf '%s\n' "$err" | head -n 1))"; pending=1
    fi
  done < <(git for-each-ref --format='%(refname:short)' "refs/heads/${prefix}*")
  git worktree prune

  if [ "$archived_ok" = 1 ]; then
    rm -rf -- "$dir"
    echo "workspace borrado: $dir"
  else
    echo "workspace conservado (archivado fallido): $dir"; pending=1
  fi
  exit "$pending"
fi

# Create-only: a repo may commit its own .gitignore here (e.g. to version
# progress.md ledgers); overwriting it would revert that on every run.
[ -e "$base/.gitignore" ] || printf '*\n' > "$base/.gitignore"
CDPATH='' cd -- "$dir" && pwd
